}

.unitgit-file-row-name {
    color: #42c879;
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    -unity-text-align: middle-left;
    align-self: center;
}

.unitgit-file-row Label,
.unitgit-file-row .unity-label {
    -unity-text-align: middle-left;
}

.unitgit-details-card {
    flex-grow: 1;
    min-height: 0;
    padding: 14px;
}

.unitgit-details-title {
    color: #eef4ff;
    -unity-font-style: bold;
    font-size: 13px;
    white-space: normal;
    margin-bottom: 12px;
}

.unitgit-details-hash {
    color: #85b6ff;
    margin-bottom: 4px;
}

.unitgit-details-text {
    color: #d9e7ff;
    white-space: normal;
    margin-bottom: 4px;
}

.unitgit-details-muted {
    color: #8992a2;
    white-space: normal;
    margin-bottom: 12px;
}

.unitgit-decoration-line {
    color: #d7ca58;
    white-space: normal;
}

.unitgit-local-pane {
    flex-grow: 1;
    min-width: 350px;
    border-right-width: 1px;
    border-right-color: #2a2e35;
}

.unitgit-changes-pane {
    flex-grow: 1;
    min-width: 280px;
    min-height: 0;
    background-color: #383838;
    border-right-width: 1px;
    border-right-color: #303030;
}

.unitgit-changes-header {
    height: 42px;
    min-height: 42px;
    padding-left: 18px;
    padding-right: 14px;
    border-bottom-width: 1px;
    border-bottom-color: #303030;
    border-radius: 0;
}

.unitgit-changes-header .unitgit-foldout-title {
    color: #ffffff;
    -unity-font-style: bold;
    font-size: 13px;
}

.unitgit-changes-header .unitgit-foldout-detail {
    color: #9aa4b3;
    font-size: 12px;
}

.unitgit-changes-actions {
    height: 38px;
    min-height: 38px;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #303030;
}

.unitgit-changes-list {
    flex-grow: 1;
    min-height: 0;
    background-color: #383838;
}

.unitgit-change-file-row {
    height: 28px;
    min-height: 28px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    -unity-text-align: middle-left;
    border-width: 0;
    border-radius: 4px;
    margin-left: 0;
    margin-right: 4px;
    margin-bottom: 1px;
    padding-left: 8px;
