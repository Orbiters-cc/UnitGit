}

.unitgit-change-file-icon {
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;
    margin-right: 8px;
    -unity-background-image-tint-color: #dfe7f5;
}

.unitgit-change-file-name {
    color: #70b7ff;
    flex-shrink: 0;
    max-width: 230px;
    white-space: nowrap;
    overflow: hidden;
    -unity-text-align: middle-left;
    align-self: center;
}

.unitgit-change-file-directory {
    margin-left: 7px;
    color: #8d95a3;
    white-space: nowrap;
    overflow: hidden;
    flex-grow: 1;
    -unity-text-align: middle-left;
}

.unitgit-change-file-status {
    width: 70px;
    color: #d7ca58;
    font-size: 10px;
    -unity-text-align: middle-right;
}

.unitgit-change-file-row Label {
    -unity-text-align: middle-left;
}

.unitgit-change-file-row .unity-label {
    -unity-text-align: middle-left;
}

.unitgit-change-folder {
    height: 26px;
    min-height: 26px;
    margin-left: 0;
    margin-right: 4px;
    padding-left: 8px;
    padding-right: 8px;
}

.unitgit-change-folder .unitgit-foldout-title {
    color: #dfe7f5;
}

.unitgit-change-folder .unitgit-foldout-detail {
    color: #8992a2;
    font-size: 11px;
}

.unitgit-local-commit-panel {
    min-height: 54px;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 8px;
    border-top-width: 1px;
    border-top-color: #303030;
}

.unitgit-local-commit-message {
    flex-grow: 1;
    height: 30px;
    margin-right: 8px;
}

.unitgit-local-commit-message .unity-base-field__input,
.unitgit-local-commit-message .unity-base-text-field__input,
.unitgit-local-commit-message .unity-text-field__input,
.unitgit-local-commit-message .unity-text-input {
    background-color: #303030;
    color: #eef4ff;
    border-width: 1px;
    border-color: #4b4b4b;
    border-radius: 5px;
    padding-left: 8px;
}

.unitgit-diff-pane {
    flex-grow: 1;
    min-width: 420px;
    min-height: 0;
    background-color: #303030;
}

.unitgit-diff-pane-container {
    flex-grow: 1;
    min-width: 420px;
    min-height: 0;
}

.unitgit-diff-toolbar {
    height: 38px;
    min-height: 38px;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #383838;
}

.unitgit-diff-tool-button {
    width: 28px;
    height: 24px;
    min-width: 28px;
    min-height: 24px;
    margin-right: 4px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
