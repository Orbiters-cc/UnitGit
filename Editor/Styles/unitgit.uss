}

.unitgit-diff-search .unity-base-field__input,
.unitgit-diff-search .unity-base-text-field__input,
.unitgit-diff-search .unity-text-field__input,
.unitgit-diff-search .unity-text-input {
    background-color: #303030;
    border-width: 1px;
    border-color: #3a3f47;
    border-radius: 4px;
    color: #cfd8e8;
    padding-left: 6px;
}

.unitgit-diff-path-row {
    height: 30px;
    min-height: 30px;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    color: #cfd8e8;
    border-bottom-width: 1px;
    border-bottom-color: #383838;
}

.unitgit-diff-header {
    height: 28px;
    min-height: 28px;
    flex-direction: row;
    border-bottom-width: 1px;
    border-bottom-color: #383838;
}

.unitgit-diff-header-cell {
    flex-grow: 1;
    width: 50%;
    color: #ffffff;
    padding-left: 12px;
    -unity-text-align: middle-left;
}

.unitgit-diff-scroll {
    flex-grow: 1;
    min-height: 0;
}

.unitgit-diff-line {
    min-height: 20px;
    flex-direction: row;
}

.unitgit-diff-cell {
    width: 50%;
    flex-grow: 1;
    min-width: 420px;
    color: #dce5f4;
    padding-left: 12px;
    padding-right: 12px;
    white-space: nowrap;
    overflow: hidden;
}

.unitgit-diff-line--hunk .unitgit-diff-cell {
    background-color: #383838;
    color: #8d95a3;
}

.unitgit-diff-line--added .unitgit-diff-cell,
.unitgit-diff-line--changed .unitgit-diff-cell {
    background-color: rgba(49, 89, 64, 0.82);
}

.unitgit-diff-line--removed .unitgit-diff-cell {
    background-color: rgba(95, 57, 57, 0.78);
}

.unitgit-diff-line--search-match .unitgit-diff-cell {
    border-left-width: 2px;
    border-left-color: #d7ca58;
}

.unitgit-diff-line--search-current .unitgit-diff-cell {
    background-color: rgba(91, 103, 58, 0.95);
}

.unitgit-commit-pane {
    min-width: 300px;
    flex-shrink: 0;
    background-color: #383838;
}

.unitgit-scroll {
    flex-grow: 1;
    min-height: 0;
}

.unitgit-row-actions {
    min-height: 42px;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
}

.unitgit-button {
    height: 28px;
    min-height: 28px;
    background-color: #595959;
    color: #ffffff;
    border-width: 0;
    border-radius: 8px;
    padding-left: 10px;
    padding-right: 10px;
    margin-right: 8px;
}

.unitgit-button:hover {
    background-color: #6a6a6a;
}

.unitgit-button:active {
    background-color: #31548f;
}

.unitgit-button--primary {
    background-color: #00da6d;
    color: #ffffff;
    -unity-font-style: bold;
}

.unitgit-button--primary:hover {
    background-color: #13e47c;
}

.unitgit-button Label {
    color: #ffffff;
}

.unitgit-github-setup {
    flex-grow: 1;
    background-color: #303030;
    padding: 14px;
}

.unitgit-github-setup-title {
    color: #ffffff;
    -unity-font-style: bold;
    font-size: 14px;
    margin-bottom: 8px;
}

.unitgit-github-setup-body {
    color: #cfd8e8;
    white-space: normal;
    margin-bottom: 12px;
}

.unitgit-github-setup-field {
    margin-bottom: 8px;
}

.unitgit-github-setup-field .unity-label {
    color: #dfe7f5;
    min-width: 82px;
}

.unitgit-github-setup-field .unity-base-field__input,
.unitgit-github-setup-field .unity-base-text-field__input,
.unitgit-github-setup-field .unity-text-field__input,
.unitgit-github-setup-field .unity-text-input {
    background-color: #303030;
    color: #eef4ff;
    border-width: 1px;
    border-color: #4b4b4b;
    border-radius: 5px;
    padding-left: 8px;
}

.unitgit-github-setup-toggle {
    color: #dfe7f5;
    margin-bottom: 8px;
}

.unitgit-console-tail {
    margin: 12px;
    flex-grow: 1;
    min-height: 100px;
    background-color: #303030;
    border-radius: 8px;
    border-width: 1px;
    border-color: #282d35;
    padding: 8px;
}

.unitgit-console-full {
    flex-grow: 1;
    min-height: 0;
    padding: 14px;
    background-color: #303030;
}

.unitgit-console-scroll {
    flex-grow: 1;
    min-height: 0;
    background-color: #383838;
    border-radius: 8px;
    border-width: 1px;
    border-color: #282d35;
    padding: 10px;
}

.unitgit-console-line {
    color: #cbd4e3;
    font-size: 11px;
    white-space: normal;
    margin-bottom: 4px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding-left: 0;
    padding-right: 0;
}

.unitgit-console-line .unity-base-field__input,
.unitgit-console-line .unity-base-text-field__input,
.unitgit-console-line .unity-text-field__input,
.unitgit-console-line .unity-text-input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: #cbd4e3;
    padding-left: 0;
    padding-right: 0;
    -unity-text-align: middle-left;
}

.unitgit-shelf-row {
    min-height: 30px;
    margin-left: 12px;
    margin-right: 12px;
    margin-bottom: 4px;
    background-color: #303030;
    border-width: 0;
    border-radius: 6px;
    color: #eef4ff;
    -unity-text-align: middle-left;
    justify-content: flex-start;
}

.unitgit-shelf-row:hover {
    background-color: #383838;
}

.unitgit-shelf-row--selected {
    background-color: #31548f;
}

.unitgit-shelf-row Label {
    color: #eef4ff;
    -unity-text-align: middle-left;
}

.unitgit-message-panel {
    width: 620px;
    max-width: 620px;
    align-self: center;
    margin-top: 72px;
    background-color: #383838;
    border-radius: 8px;
    border-left-width: 4px;
    border-left-color: #00da6d;
    padding: 22px;
}

.unitgit-message-title {
    color: #ffffff;
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.unitgit-message-body {
    color: #d1d1d1;
    white-space: normal;
    margin-bottom: 12px;
}

.unitgit-path-label {
    color: #85b6ff;
    background-color: #303030;
    border-radius: 6px;
    padding: 8px;
    margin-bottom: 12px;
    white-space: normal;
}

.unitgit-init-toggle {
    margin-top: 2px;
    margin-bottom: 4px;
}

.unitgit-init-toggle Label {
    color: #ffffff;
}

.unitgit-init-toggle-detail {
    color: #d1d1d1;
    font-size: 11px;
    white-space: normal;
    margin-bottom: 14px;
}

.unitgit-settings-root {
    flex-grow: 1;
    min-height: 0;
    padding: 16px;
    background-color: #303030;
}

.unitgit-settings-panel {
    width: 560px;
    max-width: 560px;
    background-color: #383838;
    border-radius: 8px;
    border-width: 1px;
    border-color: #282d35;
    padding: 14px;
}

.unitgit-settings-toggle {
    margin-top: 12px;
    margin-bottom: 2px;
}

.unitgit-settings-toggle Label {
    color: #eef4ff;
}

.unitgit-settings-detail {
    color: #9fa8b8;
    font-size: 11px;
    white-space: normal;
    margin-top: 4px;
}

.unitgit-message-actions {
    flex-direction: row;
    align-items: center;
}

.unitgit-empty {
    color: #8992a2;
    padding: 14px;
    white-space: normal;
}

.unitgit-branch-prompt {
    background-color: #303030;
    padding: 14px;
}

.unitgit-branch-prompt-title {
    color: #ffffff;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.unitgit-branch-prompt-field {
    height: 30px;
}

.unitgit-branch-prompt-field .unity-base-field__input,
.unitgit-branch-prompt-field .unity-base-text-field__input,
.unitgit-branch-prompt-field .unity-text-field__input,
.unitgit-branch-prompt-field .unity-text-input {
    background-color: #383838;
    color: #eef4ff;
    border-width: 1px;
    border-color: #4b4b4b;
    border-radius: 5px;
    padding-left: 8px;
}

.unitgit-release-row {
    margin-top: 3px;
    margin-bottom: 3px;
    margin-left: 6px;
    margin-right: 10px;
    height: 34px;
    min-height: 34px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 218, 109, 0.05);
    border-width: 1px;
    border-color: #00da6d;
    border-radius: 9px;
    padding-left: 12px;
    padding-right: 12px;
}

.unitgit-release-row:hover {
    background-color: rgba(0, 218, 109, 0.12);
}

.unitgit-release-row:active {
    background-color: rgba(0, 218, 109, 0.2);
}

.unitgit-release-row--selected {
    background-color: rgba(0, 218, 109, 0.16);
    border-color: #38ff9c;
}

.unitgit-release-name {
    color: #eefff5;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    flex-shrink: 0;
}

.unitgit-release-pill {
    margin-left: 10px;
    color: #00da6d;
    border-width: 1px;
    border-color: #00da6d;
    border-radius: 8px;
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 1px;
    padding-bottom: 1px;
    font-size: 10px;
    white-space: nowrap;
    flex-shrink: 0;
}

.unitgit-release-title {
    margin-left: 12px;
    color: #b9c7bf;
    font-size: 11px;
    white-space: nowrap;
    overflow: hidden;
    flex-shrink: 1;
    min-width: 0;
}

.unitgit-graph-ring {
    position: absolute;
    left: 11px;
    top: 5px;
    width: 20px;
    height: 20px;
    min-width: 20px;
    min-height: 20px;
    border-radius: 10px;
    border-width: 2px;
    border-color: #00da6d;
    background-color: rgba(0, 0, 0, 0);
}

.unitgit-graph-dot--release {
    background-color: #00da6d;
    border-color: #123524;
}

.unitgit-release-panel {
    flex-grow: 1;
}

.unitgit-release-card {
    margin: 8px;
    padding: 10px;
    background-color: #242424;
    border-width: 1px;
    border-color: #00da6d;
    border-radius: 9px;
}

.unitgit-release-headline {
    flex-direction: row;
    align-items: center;
}

.unitgit-release-details-name {
    color: #eefff5;
    font-size: 14px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    flex-shrink: 1;
    min-width: 0;
}

.unitgit-release-scope {
    margin-left: 8px;
    color: #9ab5e7;
    font-size: 10px;
    border-width: 1px;
    border-color: #4b4b4b;
    border-radius: 8px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 1px;
    padding-bottom: 1px;
    white-space: nowrap;
    flex-shrink: 0;
}

.unitgit-release-details-title {
    margin-top: 4px;
    color: #cfd8e8;
    font-size: 12px;
    white-space: normal;
}

.unitgit-release-meta-row {
    flex-direction: row;
    margin-top: 4px;
}

.unitgit-release-meta-key {
    width: 110px;
    min-width: 110px;
    color: #8f9aa8;
    font-size: 11px;
}

.unitgit-release-meta-value {
    color: #eef4ff;
    font-size: 11px;
    white-space: normal;
    flex-shrink: 1;
    min-width: 0;
}

.unitgit-release-changelog-header {
    margin-left: 10px;
    margin-top: 6px;
    color: #8f9aa8;
    font-size: 11px;
    -unity-font-style: bold;
}

.unitgit-release-changelog {
    margin: 4px 10px 10px 10px;
    padding: 8px;
    background-color: #1d1d1d;
    border-width: 1px;
    border-color: #3a3a3a;
    border-radius: 6px;
    color: #cfd8e8;
    font-size: 11px;
    white-space: normal;
}
